RIOT_API_KEY=RGAPI-발급받은-키
UPLOADER_TOKEN=길고-무작위인-업로드-전용-인증키
OPENAI_API_KEY=sk-proj-서버에서만-사용할-키
OPENAI_MODEL=gpt-5.6-luna
SERIES_COMMENTARY_DAILY_LIMIT=8
# 경기 저장소 전환: blob(기본) -> shadow(이중 쓰기) -> postgres
MATCH_STORE_MODE=blob
DATABASE_URL=postgresql://사용자:비밀번호@호스트/데이터베이스?sslmode=require
PUBLIC_APP_URL=https://lol-ck.vercel.app/
# Discord Developer Portal에서 이 앱의 OAuth2 Redirect URI로 등록
DISCORD_OAUTH_REDIRECT_URI=https://lol-ck.vercel.app/api/auth/discord/callback
DISCORD_OAUTH_CLIENT_ID=디스코드-애플리케이션-ID
DISCORD_OAUTH_CLIENT_SECRET=서버에만-저장할-디스코드-OAuth-시크릿
DISCORD_SESSION_SECRET=32자-이상의-무작위-세션-서명키
# 시리즈 편집·삭제 권한: 응CK 서버 구성원을 Discord Bot API로 매 요청 확인
DISCORD_GUILD_ID=1434891063327461481
DISCORD_BOT_TOKEN=서버에만-저장할-응CK-봇-토큰
